{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run build --prefix ../packages/shared && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env EQUATION_RENDER_MATHJAX_ONLY=1 NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=integration.spec.ts",
    "test:integration": "jest --testPathPatterns=integration.spec.ts",
    "test:publication-search": "cross-env PUBLICATION_SEARCH_INTEGRATION=1 jest --testPathPatterns=publication-catalog-search --runInBand",
    "test:typesense": "cross-env TYPESENSE_INTEGRATION=1 jest --testPathPatterns=search.integration --runInBand",
    "test:pipeline": "cross-env EMAIL_PIPELINE_INTEGRATION=1 AUTH_RETURN_BEARER=true jest --config ./test/jest-integration.json --runInBand",
    "test:query-plans": "cross-env RUN_QUERY_PLAN_TESTS=1 jest --config ./test/jest-query-plans.json --runInBand",
    "test:ai-jobs": "cross-env AI_JOBS_PIPELINE_INTEGRATION=1 AUTH_RETURN_BEARER=true jest --config ./test/jest-integration.json --testPathPatterns=ai-jobs-pipeline --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:all": "npm run test && npm run test:e2e",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/seed.ts",
    "seed:dev": "npm run seed",
    "seed:reset": "cross-env FOLIO_ALLOW_DESTRUCTIVE_SEED=1 SEED_RESET_SAMPLE=1 ts-node --transpile-only -r tsconfig-paths/register src/seed.ts",
    "seed:fresh": "cross-env FOLIO_ALLOW_DESTRUCTIVE_SEED=1 SEED_RESET_ALL=1 ts-node --transpile-only -r tsconfig-paths/register src/seed.ts",
    "seed:perf": "cross-env SEED_PERF_FIXTURES=1 ts-node --transpile-only -r tsconfig-paths/register src/seed.ts",
    "db:publication-search": "node scripts/run-publication-search.mjs",
    "smoke:auth": "node scripts/smoke-auth.mjs",
    "migrate": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migrate:prod": "node ./node_modules/typeorm/cli.js migration:run -d dist/db/data-source.js",
    "migrate:generate": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:generate src/db/migrations/Migration -d src/db/data-source.ts",
    "migrate:revert": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "@folio/nest-observability": "file:../packages/nest-observability",
    "@folio/shared": "file:../packages/shared",
    "@grpc/grpc-js": "^1.14.4",
    "@micromatrix.org/docx-math-converter": "^1.0.1",
    "@nestjs/common": "^11.1.26",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.26",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.26",
    "@nestjs/platform-ws": "^11.1.26",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.26",
    "amqplib": "^1.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.2.0",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "mathjax": "^4.1.2",
    "multer": "^2.1.1",
    "nestjs-cls": "^5.4.2",
    "nestjs-pino": "^4.4.0",
    "parse5": "^7.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "typeorm": "^0.3.28",
    "typesense": "^3.0.6",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules[/\\\\](?!(sanitize-html|htmlparser2|entities)[/\\\\])"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test-setup.ts"
    ],
    "moduleNameMapper": {
      "^@folio/nest-observability$": "<rootDir>/../../packages/nest-observability/src/index.ts",
      "^handlebars$": "<rootDir>/../node_modules/handlebars",
      "^@folio/shared/(.*)$": "<rootDir>/../../packages/shared/$1"
    }
  },
  "overrides": {
    "htmlparser2": "8.0.2"
  }
}
