# Folio backend — copy to `.env` for local dev.
# Quick start (same machine): Postgres + `docker compose -f docker-compose.dev.yml up -d`
# for RabbitMQ; optional ai-service + email-service on loopback (see services/*/.env.example).
#
NODE_ENV=development

# PostgreSQL Database Configuration
# Dev: changeme is fine locally. Production: the API refuses example/weak passwords.
DB_TYPE=postgres
DB_HOST=localhost
# docker-compose.dev.yml maps Postgres to host 5434 (avoids a local install on 5432).
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=folio_review

# Connection pool and query guardrails (optional)
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
TYPEORM_MAX_QUERY_EXECUTION_TIME_MS=

# Audit log sampling (0.0–1.0; default 1.0 = every request)
AUDIT_SAMPLE_RATE=1.0
# Audit log retention in days (default 90). Set to 0 to disable nightly purge.
# Request bodies are stored with credentials AND confidential editorial text
# (reviewer comments, decision letters, copyedit notes) redacted — see
# src/audit/audit.middleware.ts.
AUDIT_RETENTION_DAYS=90

# Shared secret for the detailed ops endpoints (/health/outbox, /health/ai-jobs).
# Empty = open, which is what local dev, the e2e suite and the k6 harness expect.
# Set it on a deployed instance; the monitor then sends x-folio-ops-token.
# Plain `GET /health` is never gated.
OPS_METRICS_TOKEN=

# API
PORT=5243
# Comma-separated for multiple dev origins (e.g. localhost vs 127.0.0.1).
FRONTEND_ORIGIN=http://localhost:5240,http://127.0.0.1:5240

# OpenAPI / Swagger UI at http://localhost:<PORT>/api-docs (JSON at /api-docs-json).
# Enabled automatically when NODE_ENV is not production. Set to true to force on in production.
SWAGGER_ENABLED=

# JWT — dev placeholder only. Production: set NODE_ENV=production and a unique random
# string (≥32 chars). Startup also enforces secrets when the env looks deployed
# (HTTPS APP_BASE_URL, remote DB, AUTH_COOKIE_SECURE=true, etc.) even if NODE_ENV
# is wrong. Set RUNTIME_CONFIG_STRICT=true to force checks in a local-looking .env.
RUNTIME_CONFIG_STRICT=
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# Auth cookies (browser uses httpOnly folio_access via Next.js proxy)
AUTH_COOKIE_SECURE=false
# Return accessToken in login/register JSON for Playwright, TestSprite API tests, and scripts.
# Bearer requests skip CSRF; keep false in production unless you understand the exposure.
AUTH_RETURN_BEARER=false

# ORCID OAuth (Sign in with ORCID + account linking)
# Register app at https://orcid.org/developer-tools (sandbox: sandbox.orcid.org)
ORCID_ENABLED=false
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Defaults to sandbox endpoints; production: https://orcid.org and https://pub.orcid.org
ORCID_API_BASE=https://sandbox.orcid.org
ORCID_PUBLIC_API_BASE=https://pub.sandbox.orcid.org
# Defaults to ${APP_BASE_URL}/api/v1/auth/orcid/callback (works with Next.js /api/v1 proxy)
ORCID_REDIRECT_URI=
ORCID_SCOPES=/authenticate /read-limited
# Test-only: mock ORCID token exchange in e2e (NODE_ENV=test)
ORCID_MOCK_ENABLED=false

# Rate limits (per-handler counters; window = THROTTLE_TTL_MS for all profiles)
THROTTLE_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=120
THROTTLE_PUBLIC_LIMIT=10000
THROTTLE_UPLOAD_LIMIT=20
# For perf harness (file-upload k6): use 10000
THROTTLE_DOCX_LIMIT=10
THROTTLE_SSE_LIMIT=10
THROTTLE_LOGIN_LIMIT=10
THROTTLE_REGISTER_LIMIT=5
THROTTLE_REFRESH_LIMIT=30
THROTTLE_AUTH_OTP_LIMIT=10
THROTTLE_AUTH_PASSWORD_RESET_LIMIT=5

# Auth email OTP / password reset
AUTH_OTP_TTL_MS=900000
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_MS=60000
AUTH_OTP_MAX_SENDS_PER_HOUR=5
AUTH_RESET_TTL_MS=3600000

# Outbound mail: configure ONLY in services/email-service/.env (EMAIL_PROVIDER, SMTP_*).
# Do not set EMAIL_PROVIDER or SMTP_* here — the backend will refuse to start.

# Uploads (relative to backend cwd)
UPLOAD_DIR=../uploads

# Email-service internal HTTP API (admin templates, reminders, pipeline slice).
# Must match services/email-service/.env when using non-loopback bind (x-folio-service-token).
EMAIL_SERVICE_URL=http://127.0.0.1:5244
EMAIL_SERVICE_TOKEN=

# RabbitMQ (used to publish ReviewerInvited / ReminderDue events to the
# email-service). Default URL targets the local docker-compose.dev.yml
# rabbitmq container.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=folio.events
# Cache TTL (ms) for passive RabbitMQ queue depth checks used by GET /admin/email/pipeline-status
EMAIL_QUEUE_METRICS_CACHE_MS=20000

# Public base URL of the frontend; used in outbound email/event links. Rules:
#   - No trailing slash.
#   - HTTPS in staging/production.
#   - http://localhost:5240 only when NODE_ENV=development.
APP_BASE_URL=http://localhost:5240
# Fallback locale for outbound email when recipient has no preferred_locale (en | ar).
DEFAULT_EMAIL_LOCALE=en

# AI service (Arabic discipline classifier). Browser must not call this directly.
AI_SERVICE_ENABLED=false
AI_SERVICE_GRPC_HOST=127.0.0.1
AI_SERVICE_GRPC_PORT=5246
# Must match services/ai-service/.env when AI is enabled (gRPC x-folio-service-token).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=120000
# Longer deadline for plagiarism jobs (local pgvector + web CSE/AraBERT).
AI_CORPUS_SIMILARITY_TIMEOUT_MS=300000
# RabbitMQ-backed AI job worker in the API process (similarity indexing, corpus similarity reports).
AI_JOBS_CONSUMER_ENABLED=true
# Reader related articles + catalog semantic search (gRPC SimilarityService; requires SIMILARITY_ENABLED on ai-service).
AI_SIMILARITY_ENABLED=false
# Web plagiarism stage (Google CSE + AraBERT; requires WEB_SIMILARITY_ENABLED on ai-service).
AI_WEB_SIMILARITY_ENABLED=false
# Author keyword suggestions (gRPC KeywordService.SuggestKeywords; requires KEYWORDS_SUGGESTION_ENABLED on ai-service).
AI_KEYWORDS_ENABLED=false
# Editor reviewer suggestions (gRPC ReviewerMatchingService.SuggestReviewers; requires REVIEWER_MATCHING_ENABLED + SIMILARITY_ENABLED on ai-service).
AI_REVIEWER_MATCHING_ENABLED=false
# Copyeditor reference cross-checking via LLM (gRPC CopyeditService.CheckReferences; requires COPYEDIT_ANALYSIS_ENABLED on ai-service).
AI_COPYEDIT_ENABLED=false
# Pipe-separated Arabic discipline labels in journal scope (empty = all model labels allowed).
# JOURNAL_ALLOWED_DISCIPLINES=العلوم القانونية|العلوم الاقتصادية والسياسية

# LanguageTool grammar/spelling check (self-hosted, see docker-compose.dev.yml).
# Start: docker compose -f docker-compose.dev.yml up -d languagetool
LANGUAGE_TOOL_ENABLED=false
LANGUAGE_TOOL_URL=http://localhost:8010

# Optional: override compile-time default (`damascus-university-journal-v1`) when valid in registry.
DEFAULT_MANUSCRIPT_STYLE_ID=

# Typesense search (public catalog). Start locally:
#   docker run -p 8108:8108 -v /tmp/typesense-data:/data typesense/typesense:26.0 \
#     --data-dir /data --api-key=xyz --enable-cors
TYPESENSE_ENABLED=false
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=xyz
TYPESENSE_COLLECTION=publications

# --- Observability (structured logs + OpenTelemetry) -----------------------------
OTEL_SERVICE_NAME=folio-backend
# Authoritative trace export switch: none | otlp
OTEL_TRACES_EXPORTER=none
# Required when OTEL_TRACES_EXPORTER=otlp (e.g. http://localhost:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional sampling (e.g. parentbased_traceidratio + OTEL_TRACES_SAMPLER_ARG=0.1)
# OTEL_TRACES_SAMPLER=parentbased_always_on
LOG_LEVEL=info
# pretty (local) | json (production)
LOG_FORMAT=pretty

# --- Public site identity + OAI-PMH harvesting ----------------------------------
# The public origin the journal is served from, no trailing slash. Also used to
# build absolute URLs in harvested metadata, so it must be the real domain in
# production (docs/EXTERNAL-ACTIONS.md A3). Locally, point it at the frontend.
#
# PRODUCTION VALUE, fixed by the university 2026-09-12 — use exactly this, and
# set it before the first harvest. OAI record identifiers are
# `oai:<domain>:<slug>` and are permanent; a later domain change orphans every
# record an aggregator has already indexed.
#   PUBLIC_SITE_URL=https://journal.damascusuniversity.edu.sy
# DNS and TLS are administered by the DU ICT centre (مركز تقانة المعلومات).
PUBLIC_SITE_URL=http://localhost:5240

# The OAI-PMH endpoint refuses to serve until BOTH of the above and the admin
# address below are set.
# A real, monitored contact address — it is published in the Identify response.
# Proposed by the university: ojs.admin@damascusuniversity.edu.sy (the mailbox
# has to be created and monitored before it goes in here — DOAJ and OpenAIRE
# both write to it). The press's general contact is
# journals.dpt@damascusuniversity.edu.sy.
OAI_ADMIN_EMAIL=

# Optional overrides. The repository identifier defaults to PUBLIC_SITE_URL's
# host; set it explicitly ONLY before first harvest, never after (see above).
# OAI_REPOSITORY_IDENTIFIER=
# OAI_REPOSITORY_NAME=Damascus University Journals
# OAI_PUBLISHER_NAME=Damascus University

# Emitted as dc:rights on every harvested record. CC BY-NC is the licence the
# university approved on 2026-09-12 for all nine journals and the entire back
# catalogue (docs/EXTERNAL-ACTIONS.md B1). Change it only with the same
# authority that set it — harvesters cache rights statements.
OAI_RIGHTS_STATEMENT=This work is licensed under a Creative Commons Attribution-NonCommercial 4.0 International License (CC BY-NC 4.0). https://creativecommons.org/licenses/by-nc/4.0/
