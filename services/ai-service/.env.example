# Damascus University Journal ai-service configuration.
# Copy to `.env` for local development.

# --- Runtime ---------------------------------------------------------------
APP_ENV=development
PORT=5245
# Same-machine default: loopback only. Set 0.0.0.0 only when another host/container must connect.
HTTP_BIND_HOST=127.0.0.1
GRPC_PORT=5246
GRPC_BIND_HOST=127.0.0.1
LOG_LEVEL=info
LOG_FORMAT=pretty
OTEL_SERVICE_NAME=folio-ai-service
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set true to enforce production-style validation in local dev.
RUNTIME_CONFIG_STRICT=false

# Shared secret for Nest → ai-service (gRPC metadata x-folio-service-token).
# When set, internal callers must send matching metadata on all product RPCs.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match backend/.env AI_SERVICE_TOKEN when AI_SERVICE_ENABLED=true.
AI_SERVICE_TOKEN=

# --- AI provider -----------------------------------------------------------
# `noop` is the default: no external API calls (safe for local dev).
# `openai` uses the OpenAI-compatible HTTP API (or OPENAI_BASE_URL override).
AI_PROVIDER=noop

# Required when AI_PROVIDER=openai (and in production / strict mode).
OPENAI_API_KEY=

# Optional: Azure OpenAI, local gateways (Ollama, LiteLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Local LM Studio (Windows): run-dev.bat reads OPENAI_MODEL and runs `lms load`.
# Example: OPENAI_BASE_URL=http://localhost:1234/v1  OPENAI_API_KEY=lm-studio
# OPENAI_MODEL must match an `lms ls` model key (also used as the API model id).

OPENAI_MODEL=gpt-4o-mini

# --- AraBERT discipline classifier (optional) ------------------------------
# Exposed via gRPC ClassifierService when enabled.
# Requires: pip install -e ".[ml]" and fine-tuned weights on disk.
ARABERT_ENABLED=false
# Preload tokenizer + weights at startup when true (avoids ~1 min first UI classify).
ARABERT_WARMUP_ON_STARTUP=true
# ARABERT_MODEL_PATH=
# ARABERT_PREPROCESSOR_MODEL=aubmindlab/bert-base-arabertv02
# ARABERT_DEFAULT_THRESHOLD=0.0
# ARABERT_IDLE_TIMEOUT_SECONDS=300

# --- Reader related articles (pgvector + embeddings) -----------------------
# Requires: pip install -e ".[similarity]" and pgvector-enabled Postgres (folio_review).
SIMILARITY_ENABLED=false
# Editor reviewer matching (same similarity extras + VECTOR_DB_*).
REVIEWER_MATCHING_ENABLED=false
# VECTOR_DB_HOST=localhost
# VECTOR_DB_PORT=5432
# VECTOR_DB_USER=postgres
# VECTOR_DB_PASSWORD=changeme
# VECTOR_DB_DATABASE=folio_review
# VECTOR_DB_SSL=false
# VECTOR_DB_HNSW_EF_SEARCH=64
# SIMILARITY_MODEL_NAME=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# SIMILARITY_BATCH_SIZE=32
# SIMILARITY_DEFAULT_LIMIT=5
# SIMILARITY_SEARCH_DEFAULT_LIMIT=20
# SIMILARITY_DEFAULT_THRESHOLD=0.35
# SIMILARITY_SAME_CATEGORY_ONLY=true
# SIMILARITY_DEVICE=cpu

# --- Author keyword suggestions (OpenAI LLM) -------------------------------
# Requires AI_PROVIDER=openai and a real OPENAI_API_KEY.
KEYWORDS_SUGGESTION_ENABLED=false

# --- Copyeditor reference cross-checking (OpenAI LLM) ----------------------
# Requires AI_PROVIDER=openai and a real OPENAI_API_KEY.
COPYEDIT_ANALYSIS_ENABLED=false

# --- Web plagiarism (Google CSE + AraBERT) ---------------------------------
# Requires: pip install -e ".[ml,web_similarity]"
WEB_SIMILARITY_ENABLED=false
# GOOGLE_CSE_API_KEY=
# GOOGLE_CSE_ID=
# FARASA_API_KEY=
# WEB_SIMILARITY_MAX_QUERIES=5
# WEB_SIMILARITY_RESULTS_PER_QUERY=10
# WEB_SIMILARITY_THRESHOLD=70
# WEB_SIMILARITY_SEARCH_LANG=ar
# WEB_SIMILARITY_FETCH_WORKERS=5
