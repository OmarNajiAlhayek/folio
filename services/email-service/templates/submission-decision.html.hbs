{{#> folio-email-layout dir="ltr" lang="en"}}
<p style="margin:0 0 16px;">Dear {{authorDisplayName}},</p>
{{#if isAccepted}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px;">
  <tr>
    <td style="background-color:#ecfdf5;border:1px solid #bbf7d0;border-radius:6px;padding:14px 16px;">
      Your manuscript <strong>{{submissionTitle}}</strong> has been <strong style="color:#166534;">accepted</strong>.
    </td>
  </tr>
</table>
{{/if}}
{{#if isRejected}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px;">
  <tr>
    <td style="background-color:#fef2f2;border:1px solid #fecaca;border-radius:6px;padding:14px 16px;">
      {{#if isDeskReject}}
      Following an initial editorial review, your manuscript <strong>{{submissionTitle}}</strong> has been <strong style="color:#991b1b;">declined</strong> without proceeding to peer review.
      {{else}}
      After editorial consideration, your manuscript <strong>{{submissionTitle}}</strong> has been <strong style="color:#991b1b;">declined</strong>.
      {{/if}}
    </td>
  </tr>
</table>
{{/if}}
{{#if isRevisionsRequested}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px;">
  <tr>
    <td style="background-color:#fffbeb;border:1px solid #fde68a;border-radius:6px;padding:14px 16px;">
      {{#if isMajorRevision}}
      The editor has requested <strong style="color:#92400e;">major revisions</strong> for your manuscript <strong>{{submissionTitle}}</strong>. Substantial changes are needed, and the revised manuscript may be sent back to the reviewers.
      {{else}}
      The editor has requested <strong style="color:#92400e;">minor revisions</strong> for your manuscript <strong>{{submissionTitle}}</strong>. The changes required are limited in scope.
      {{/if}}
    </td>
  </tr>
</table>
{{#if hasReviewFiles}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px;">
  <tr>
    <td style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:14px 16px;">
      <strong>{{reviewFileCount}}</strong> reviewer file(s) have been shared with you. You can download them from your submission page.
    </td>
  </tr>
</table>
{{/if}}
{{/if}}
{{#if hasMessageForAuthor}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 16px;">
  <tr>
    <td style="background-color:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:14px 16px;">
      <p style="margin:0 0 8px;font-size:12px;font-weight:600;color:#475569;text-transform:uppercase;letter-spacing:0.05em;">Message from the editor</p>
      <p style="margin:0;font-size:14px;color:#334155;white-space:pre-wrap;">{{messageForAuthor}}</p>
    </td>
  </tr>
</table>
{{/if}}
<p style="margin:0 0 16px;color:#64748b;font-size:14px;">
  Decision recorded by {{decidedByDisplayName}}.
</p>
{{> folio-email-button href=submissionUrl label="View your submission" align="left"}}
<p style="margin:24px 0 0;">Thank you,<br />Damascus University Journal editorial team</p>
{{/folio-email-layout}}
