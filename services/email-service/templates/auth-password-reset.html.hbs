{{#> folio-email-layout dir="ltr" lang="en"}}
<p style="margin:0 0 16px;">Dear {{displayName}},</p>
<p style="margin:0 0 16px;">
  We received a request to reset your Folio password. Click the button below to choose a new password.
</p>
{{> folio-email-button href=resetUrl label="Reset password" align="left"}}
<p style="margin:16px 0 0;color:#64748b;font-size:14px;">
  This link expires in 60 minutes. If you did not request a reset, you can safely ignore this email.
</p>
<p style="margin:24px 0 0;">Thank you,<br />Folio team</p>
{{/folio-email-layout}}
