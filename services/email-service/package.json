{
  "name": "@folio/email-service",
  "version": "0.1.0",
  "description": "Folio email microservice: consumes RabbitMQ events, sends transactional + scheduled emails, owns reminder lifecycle.",
  "private": true,
  "scripts": {
    "build": "npm run build --prefix ../../packages/shared && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node --transpile-only src/main.ts",
    "migrate": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:run -d src/db/data-source.ts",
    "migrate:generate": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:generate -d src/db/data-source.ts",
    "migrate:revert": "ts-node --transpile-only ./node_modules/typeorm/cli.js migration:revert -d src/db/data-source.ts",
    "test": "jest",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^handlebars$": "<rootDir>/../node_modules/handlebars",
      "^@folio/shared/(.*)$": "<rootDir>/../../../packages/shared/$1",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "dependencies": {
    "@folio/nest-observability": "file:../../packages/nest-observability",
    "@folio/shared": "file:../../packages/shared",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "amqplib": "^0.10.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.3.1",
    "handlebars": "^4.7.8",
    "nestjs-cls": "^5.4.2",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.19",
    "@types/amqplib": "^0.10.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
