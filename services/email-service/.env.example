# Folio email-service configuration.
# Copy to `.env` and fill in for local development.

NODE_ENV=development

# --- PostgreSQL --------------------------------------------------------------
# Dedicated Postgres instance for email data (separate from backend folio_review).
# Dev: changeme is fine locally. Production: startup fails on example passwords.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=folio_email
DB_SCHEMA=email

# Connection pool and query guardrails (optional)
DB_POOL_MAX=30
DB_POOL_IDLE_TIMEOUT_MS=
DB_POOL_CONNECTION_TIMEOUT_MS=
DB_STATEMENT_TIMEOUT_MS=
TYPEORM_MAX_QUERY_EXECUTION_TIME_MS=

# --- Internal HTTP API ---------------------------------------------------------
# Nest backend calls /internal/* with x-folio-service-token.
# Required in all environments (must match backend EMAIL_SERVICE_TOKEN).
EMAIL_SERVICE_TOKEN=dev-email-internal-token
HTTP_PORT=5244
HTTP_BIND_HOST=127.0.0.1
# Legacy aliases (optional; HTTP_* above is preferred):
# HEALTH_PORT=5244
# HEALTH_BIND_HOST=127.0.0.1

# --- RabbitMQ ----------------------------------------------------------------
# Must match the backend's RABBITMQ_URL/RABBITMQ_EXCHANGE so both apps
# talk to the same exchange. Default URL targets docker-compose.dev.yml.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=folio.events

# --- Email provider ----------------------------------------------------------
# `noop` logs would-be sends and is the default in dev. Switch to `smtp`
# once you've picked a real vendor (Resend/Mailgun/etc. can be added by
# implementing EmailProvider in src/providers/).
EMAIL_PROVIDER=noop
EMAIL_FROM=no-reply@folio.local

# Required when EMAIL_PROVIDER=smtp:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Reminder cadence --------------------------------------------------------
# Reviewer due-date offset in days. Reminders are scheduled relative to
# this value: due-soon at (REVIEW_DUE_IN_DAYS - 3), overdue at
# (REVIEW_DUE_IN_DAYS + 1).
REVIEW_DUE_IN_DAYS=21

# --- App base URL ------------------------------------------------------------
# Used inside reminder emails to build assignment links. Rules:
#   - No trailing slash.
#   - HTTPS in staging/production.
#   - http://localhost:5240 only when NODE_ENV=development.
APP_BASE_URL=http://localhost:5240

# --- Observability (structured logs + OpenTelemetry) ---------------------------
OTEL_SERVICE_NAME=folio-email-service
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=info
LOG_FORMAT=pretty
