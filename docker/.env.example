# ==============================================================================
# Folio stack configuration for docker-compose.yml.
#
#   cp docker/.env.example .env
#   # fill in the REQUIRED block, then:
#   docker compose build && docker compose up -d
#
# Compose reads ./.env automatically. Values marked REQUIRED have no default —
# `docker compose config` fails loudly instead of booting an insecure stack.
# The per-service .env files (backend/.env, services/*/.env) are for NATIVE dev
# only; containers are configured from this file alone.
# ==============================================================================

# --- REQUIRED: secrets --------------------------------------------------------
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_PASSWORD=
EMAIL_DB_PASSWORD=
RABBITMQ_PASSWORD=
JWT_SECRET=
# Shared secret for backend → email-service /internal/* calls.
EMAIL_SERVICE_TOKEN=
# Shared secret for backend → ai-service gRPC (x-folio-service-token).
AI_SERVICE_TOKEN=

# --- REQUIRED: public URLs ----------------------------------------------------
# Public origin of the web app. No trailing slash. HTTPS outside local runs —
# the API refuses http:// origins when it detects a deployed environment.
APP_BASE_URL=http://localhost:5240
# Origins allowed to call the API (comma-separated).
FRONTEND_ORIGIN=http://localhost:5240

# --- Published host ports -----------------------------------------------------
FRONTEND_HTTP_PORT=5240
BACKEND_HTTP_PORT=5243
RABBITMQ_MANAGEMENT_PORT=15672

# --- Image naming -------------------------------------------------------------
IMAGE_PREFIX=folio
IMAGE_TAG=local

# --- Databases ----------------------------------------------------------------
DB_USERNAME=postgres
DB_DATABASE=folio_review
EMAIL_DB_USERNAME=postgres
EMAIL_DB_DATABASE=folio_email
EMAIL_DB_SCHEMA=email
# The API runs pending migrations on boot. Set false when a release pipeline
# owns migrations (then run: docker compose run --rm backend npm run migrate:prod).
DB_MIGRATE_ON_START=true

# --- Message bus --------------------------------------------------------------
RABBITMQ_USER=folio
RABBITMQ_EXCHANGE=folio.events

# --- Auth ---------------------------------------------------------------------
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
# true whenever the app is served over HTTPS (required for cross-site cookies).
AUTH_COOKIE_SECURE=false
# Returns the access token in login JSON. Bearer requests skip CSRF — test-only.
AUTH_RETURN_BEARER=false
# Swagger UI at /api-docs. Off in production unless explicitly enabled.
SWAGGER_ENABLED=false

# --- Email delivery -----------------------------------------------------------
# noop logs would-be sends; smtp requires the SMTP_* block below.
EMAIL_PROVIDER=noop
EMAIL_FROM=no-reply@folio.local
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
REVIEW_DUE_IN_DAYS=21

# --- AI service ---------------------------------------------------------------
# Python extras baked into the ai-service image (build-time; rebuild to change):
#   corpus                exact-overlap plagiarism, ~250 MB
#   corpus,similarity     + embeddings, reviewer matching, related articles (~3 GB)
#   corpus,similarity,ml  + AraBERT discipline classifier
AI_PIP_EXTRAS=corpus
# Master switch on the API side; each feature below also needs its own flag.
AI_SERVICE_ENABLED=false
AI_PROVIDER=noop
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Feature pairs — the API flag and the ai-service flag must agree.
AI_SIMILARITY_ENABLED=false
SIMILARITY_ENABLED=false
AI_REVIEWER_MATCHING_ENABLED=false
REVIEWER_MATCHING_ENABLED=false
AI_KEYWORDS_ENABLED=false
KEYWORDS_SUGGESTION_ENABLED=false
AI_COPYEDIT_ENABLED=false
COPYEDIT_ANALYSIS_ENABLED=false
AI_WEB_SIMILARITY_ENABLED=false
WEB_SIMILARITY_ENABLED=false
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Verbatim-overlap plagiarism stage (ai-service only; needs the corpus extra).
EXACT_MATCH_ENABLED=false
ARABERT_ENABLED=false

# --- Optional infrastructure (compose profiles) -------------------------------
# docker compose --profile grammar up -d
LANGUAGE_TOOL_ENABLED=false
LANGUAGETOOL_HEAP=512m
# docker compose --profile search up -d
TYPESENSE_ENABLED=false
TYPESENSE_API_KEY=
TYPESENSE_COLLECTION=publications

# --- Manuscript rendering -----------------------------------------------------
# 1 = MathJax only (default image has no browser).
# Build with BACKEND_WITH_CHROMIUM=true and set this to 0 for the Chromium renderer.
BACKEND_WITH_CHROMIUM=false
EQUATION_RENDER_MATHJAX_ONLY=1

# --- Frontend build-time values (inlined into the client bundle) --------------
# Empty = same-origin /api/v1 through the Next.js rewrite (recommended).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# none | otlp
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Image tags (pin these for reproducible deploys) --------------------------
POSTGRES_IMAGE_TAG=pg17
POSTGRES_EMAIL_IMAGE_TAG=17-alpine
RABBITMQ_IMAGE_TAG=3-management
TYPESENSE_IMAGE_TAG=26.0
LANGUAGETOOL_IMAGE_TAG=latest
