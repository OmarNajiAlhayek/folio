# Perf harness environment (optional).
# Copy to perf/.env and `source` before running, or export inline.
# Service secrets and DB settings live in backend/.env (read automatically by pg-stat-snapshot).

# API base for perf/setup.mjs and k6 (default matches native backend)
FOLIO_API_BASE=http://localhost:5243/api/v1

# Override only when not using backend/.env (CI sets these explicitly)
# DB_HOST=localhost
# DB_PORT=5434
# DB_USERNAME=postgres
# DB_PASSWORD=changeme
# DB_DATABASE=folio_review

# k6 load tuning (optional)
# PERF_VUS=5
# PERF_EMAIL_INVITES=50

# Strict CI thresholds (set by npm run test:perf:ci)
# PERF_CI=1
