# Next.js dev server port (matches docker-compose.local.yml)
PORT=5240

# Empty = same-origin /api/v1 via Next.js rewrite (recommended for local dev)
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=http://127.0.0.1:5243

# Playwright e2e (optional — defaults work for local dev)
# E2E_API_URL=http://127.0.0.1:5243/api/v1/
# E2E_FRONTEND_PORT=5240
# E2E_BACKEND_PORT=5243
# E2E_WORKERS=1
# REUSE_DEV_SERVER=1
# E2E_EDITOR_EMAIL=manager@folio.local
# E2E_EDITOR_PASSWORD=Manager123!
# E2E_EMAIL_ADMIN_UI=1
# E2E_JM_USERS_UI=1

# Optional production error monitoring (Sentry — no-op when unset)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# Bundle analysis: npm run analyze
# ANALYZE=true

# Public origin of the journal, no trailing slash. Until this is set, robots.txt
# disallows everything and sitemap.xml is empty — so a dev or preview deployment
# never invites indexing. Set it to the real domain in production
# (docs/EXTERNAL-ACTIONS.md A3); it must match the backend's PUBLIC_SITE_URL.
# Deliberately not NEXT_PUBLIC_-prefixed: those are inlined at build time, which
# would bake the domain into the standalone Docker image.
#
# PRODUCTION VALUE, fixed by the university 2026-09-12 — must match the
# backend's PUBLIC_SITE_URL exactly:
#   PUBLIC_SITE_URL=https://journal.damascusuniversity.edu.sy
PUBLIC_SITE_URL=http://localhost:5240
